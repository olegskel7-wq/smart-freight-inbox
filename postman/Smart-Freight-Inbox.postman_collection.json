{
  "info": {
    "_postman_id": "smart-freight-inbox-v1",
    "name": "Smart Freight Inbox — API Collection",
    "description": "Complete API test collection for Smart Freight Inbox v1 demo. Includes auth, tickets (REST), admin endpoints, and health checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
