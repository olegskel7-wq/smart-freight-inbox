# Copy to .env and fill in your values. Do not commit .env.
# Gate C5: this file holds NON-SECRET config only. Passwords, keys and tokens are files in
# SECRETS_DIR (one per secret, file name = variable name) — docs/ops/secrets.md. Unset, compose
# mounts ./secrets.dev (the public dev values), so a fresh clone runs as-is.
# For IntelliJ runs (no /run/secrets): put the secrets into Run → Edit Configurations → Environment variables.

# Outside the repo. Windows (Docker Desktop): C:/Users/<you>/.smartfreight/secrets ; server: /etc/smartfreight/secrets
# SECRETS_DIR=

# Platform mail account (passwords: SECRETS_DIR/IMAP_PASSWORD and SMTP_PASSWORD)
IMAP_HOST=sandbox.imap.mailtrap.io
IMAP_PORT=993
IMAP_USER=replace_with_mailtrap_inbox_username

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=replace_with_mailtrap_inbox_username

# Optional: Gmail instead of Mailtrap (password = a 16-char App Password in SECRETS_DIR)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com

# Gate B4 — alert delivery (docs/ops/alerting.md). Optional locally; REQUIRED on a server
# (scripts/check-prod-env.sh). Secrets TELEGRAM_BOT_TOKEN + HEALTHCHECKS_PING_URL go in SECRETS_DIR.
TELEGRAM_CHAT_ID=

# Gates B1/B2 — encrypted offsite backups (docs/ops/backup-restore.md). REQUIRED on a server.
# Secrets OFFSITE_S3_ACCESS_KEY_ID, OFFSITE_S3_SECRET_ACCESS_KEY, BACKUP_ENCRYPTION_PASSPHRASE,
# BACKUP_HEALTHCHECKS_PING_URL go in SECRETS_DIR.
OFFSITE_S3_BUCKET=
