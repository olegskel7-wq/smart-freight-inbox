# Copy to .env and fill in your values. Do not commit .env.
# Spring Boot reads these via application.yaml only when exported as OS env vars.
# For IntelliJ: paste the same keys into Run → Edit Configurations → Environment variables.

IMAP_HOST=sandbox.imap.mailtrap.io
IMAP_PORT=993
IMAP_USER=replace_with_mailtrap_inbox_username
IMAP_PASSWORD=replace_with_mailtrap_inbox_password

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=replace_with_mailtrap_inbox_username
SMTP_PASSWORD=replace_with_mailtrap_inbox_password

# Optional: Gmail instead of Mailtrap
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=your_16char_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16char_app_password

# Gate B4 — alert delivery (docs/ops/alerting.md). Optional locally; REQUIRED on a server
# (scripts/check-prod-env.sh refuses a .env without them).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECKS_PING_URL=

# Gates B1/B2 — encrypted offsite backups (docs/ops/backup-restore.md). REQUIRED on a server.
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_HEALTHCHECKS_PING_URL=

# V38 — Microsoft 365 mailboxes (XOAUTH2). Our Entra app registration; blank = M365 sign-in off.
# Setup: docs/ops/m365-oauth2-setup.md
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
