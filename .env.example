# Copy to .env and fill in your values. Do not commit .env.
# Spring Boot reads these via application.yaml only when exported as OS env vars.
# For IntelliJ: paste the same keys into Run → Edit Configurations → Environment variables.

IMAP_HOST=sandbox.imap.mailtrap.io
IMAP_PORT=993
IMAP_USER=replace_with_mailtrap_inbox_username
IMAP_PASSWORD=replace_with_mailtrap_inbox_password

# Optional: Outlook instead of Mailtrap
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=you@outlook.com
# IMAP_PASSWORD=your_password_or_ms_app_password
